PORT=3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
DB_NAME=summitsgo
# opsional: isi hanya bila muncul error "querySrv ECONNREFUSED" saat menyambung ke MongoDB
DNS_SERVERS=
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173
# alamat backend yang dibuka browser, dipakai untuk URL foto (ganti saat deploy)
PUBLIC_URL=http://localhost:3000
# folder foto unggahan, relatif terhadap folder backend
UPLOAD_DIR=uploads

# Password akun admin untuk npm run seed (minimal 12 karakter, jangan dibagikan)
ADMIN_PASSWORD=
